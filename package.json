{
  "name": "osoitekirjasovellus",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist && node scripts/web-relative-paths.js dist",
    "deploy": "npm run export:web && gh-pages -d dist --dotfiles --nojekyll"
  },
  "dependencies": {
    "@expo/metro-runtime": "~2.2.16",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.16",
    "expo": "^49.0.16",
    "expo-sqlite": "~11.3.3",
    "expo-status-bar": "~1.6.0",
    "leaflet": "^1.9.4",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.72.6",
    "react-native-elements": "^3.4.3",
    "react-native-maps": "1.7.1",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "gh-pages": "^6.3.0"
  },
  "private": true
}
